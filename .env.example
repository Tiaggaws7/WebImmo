# Copier ce fichier vers .env puis renseigner les valeurs.
# .env est ignoré par Git : ne jamais y committer de secret.

# Clé API Firebase (publique côté navigateur, mais à restreindre : voir SECURITY.md).
VITE_FIREBASE_API_KEY=

# App Check (reCAPTCHA v3) : clé de site créée dans Firebase Console.
# Laisser vide pour désactiver App Check (développement local).
VITE_RECAPTCHA_SITE_KEY=

# EmailJS (formulaires de contact, vente et estimation).
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_VENDRE_TEMPLATE_ID=
VITE_EMAILJS_ESTIMATION_TEMPLATE_ID=
VITE_EMAILJS_USER_ID=

# Contentful (blog).
VITE_CONTENTFUL_SPACE_ID=
VITE_CONTENTFUL_ACCESS_TOKEN=

# Mesure d'audience intégrée (optionnel).
# En production, laisser vide : le site utilise /api/track (même origine).
# En local, pointer vers l'émulateur, par exemple :
# http://127.0.0.1:5001/webimmo-6189a/us-central1/track
VITE_ANALYTICS_URL=

# API du tableau de bord (optionnel en local).
# En production, laisser vide : le site utilise /api/analytics.
VITE_ANALYTICS_API_URL=

# API des demandes (optionnel en local).
# En production, laisser vide : le site utilise /api/leads.
VITE_LEADS_URL=
